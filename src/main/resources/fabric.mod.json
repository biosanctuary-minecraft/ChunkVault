{
  "schemaVersion": 1,
  "id": "chunkvault",
  "version": "${version}",
  "name": "ChunkVault",
  "description": "Saves loaded chunks and opened container contents to a real world save as you play (26.2).",
  "authors": ["biosanctuary"],
  "contact": {
    "sources": "https://github.com/biosanctuary-minecraft/ChunkVault",
    "issues": "https://github.com/biosanctuary-minecraft/ChunkVault/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.chunkvault.ChunkVaultClient"
    ]
  },
  "mixins": [
    "chunkvault.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
